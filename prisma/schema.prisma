// Pen Lake Ventures — Leasing & PM system
// Phase 1 schema, translated from docs/phase0_data_model.md.
// Scope: leasing and property management only. Development/construction stays out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

// Two users today (Ryan, Alina), both full access. Role is a plain string
// (not an enum) so new roles — e.g. an outsourced PM company with scoped
// access — can be introduced later without a schema migration.
model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  // "owner" (full access, including Financials) or "staff" (everything
  // except Financials). Defaults to the least-privileged value on
  // purpose — a row ever created without specifying this explicitly
  // should never accidentally get owner-level access.
  role               String   @default("staff")
  // Defaults to true (not false) so that adding this column to an
  // already-populated users table is the conservative choice: any
  // existing account is treated as "not confirmed to have rotated its
  // password" until proven otherwise, rather than silently trusting it.
  mustChangePassword Boolean  @default(true)
  // Defaults to true for the same reason mustChangePassword does — an
  // account is assumed usable unless explicitly deactivated. Blocks both
  // new logins and an already-open session (checked on every request,
  // not just at sign-in) — see auth.ts.
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  proposedRentRecommendations   RentRecommendation[] @relation("ProposedRentRecommendations")
  decidedRentRecommendations    RentRecommendation[] @relation("DecidedRentRecommendations")

  @@map("users")
}

// ---------------------------------------------------------------------------
// 1. Project entity — the 7 single-purpose corporations, each the legal
//    owner of one property.
// ---------------------------------------------------------------------------
model ProjectEntity {
  id           String   @id @default(cuid())
  internalName String   @unique // e.g. "Killarney23" — matches financial statements
  websiteCode  String   @unique // e.g. "KLY2337" — matches penventures.ca
  neighbourhood String
  address      String
  occupancyDate DateTime
  cmhcLoanRef  String? // optional, for later linking to renewal-ladder tracking
  // Owner-specified display order (not alphabetical) — every list of
  // projects, and every unit list grouped by project, sorts by this.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  units             Unit[]
  complianceRecords ComplianceRecord[]
  monthlyExpenses   MonthlyExpense[]
  financialSettings FinancialSettings?

  @@map("project_entities")
}

// ---------------------------------------------------------------------------
// 2. Unit
// ---------------------------------------------------------------------------
enum CmhcDesignation {
  MARKET
  AFFORDABLE
}

enum TenancyType {
  EXTERNAL
  INTERNAL // e.g. the barn — a Pen-to-Pen payment, flagged for financial reporting clarity
}

model Unit {
  id              String          @id @default(cuid())
  projectEntityId String
  projectEntity   ProjectEntity   @relation(fields: [projectEntityId], references: [id], onDelete: Restrict)
  unitNumber      String // how this unit is identified on the real rent roll/address (e.g. "203") — the project address plus this uniquely identifies the unit, so a separate town/suite category isn't needed
  bedrooms        Int
  sqft            Int?
  cmhcDesignation CmhcDesignation
  baseRent        Decimal         @db.Decimal(10, 2)
  currentRent     Decimal         @db.Decimal(10, 2)
  tenancyType     TenancyType     @default(EXTERNAL)
  // Which lease template a new lease for this unit uses (see "Send for
  // signature" on the Lease page): true = utilities included in rent
  // (the "Suite" template), false = tenant pays utilities directly (the
  // "Townhome" template). Defaults off since that's the more common case
  // portfolio-wide; set per unit, not inferred from anything else.
  utilitiesIncludedInRent Boolean @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  leases              Lease[]
  tickets             MaintenanceTicket[]
  rentRecommendations RentRecommendation[]

  @@index([projectEntityId])
  @@map("units")
}

// ---------------------------------------------------------------------------
// 3. Tenant
// ---------------------------------------------------------------------------
model Tenant {
  id                  String  @id @default(cuid())
  name                String
  phone               String?
  email                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  leases          LeaseTenant[]
  tickets         MaintenanceTicket[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// 4. Lease (+ join table for multiple tenants per lease)
// ---------------------------------------------------------------------------
model Lease {
  id                  String    @id @default(cuid())
  unitId              String
  unit                Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate           DateTime
  endDate             DateTime?
  periodic            Boolean   @default(false) // month-to-month / periodic tenancy with no fixed end date
  rentAmount           Decimal   @db.Decimal(10, 2)
  lastRentIncreaseDate DateTime? // anchor for the 365-day-between-increases rule; null = never increased since this app tracked it
  rentIncreaseNoticeGivenDate DateTime? // when written notice was given for the current rentAmount, if it was an increase
  firstMonthRentPrepaid Decimal? @db.Decimal(10, 2)
  lastMonthRentPrepaid Decimal?  @db.Decimal(10, 2)
  pets                 String? // free text, e.g. "dog, cat"
  signedDate           DateTime?
  documentLink         String?
  // The actual Dropbox path behind documentLink (a shared link isn't
  // something the Dropbox upload API can write to directly) — set
  // alongside it when prepareLeaseFolder() creates the folder, so
  // uploading a document later (e.g. a SingleKey report once someone's
  // approved) has a stable target without re-deriving or re-creating
  // anything. Null for a lease predating this, or one where staff pasted
  // a link by hand instead — upload just isn't offered there.
  documentsFolderPath  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // E-signature (Dropbox Sign) — set once "Send for signature" is used.
  // signatureRequestId is null until sent. signatureCompletedAt is a
  // dedicated field, deliberately separate from signedDate (above) even
  // though they'll usually hold the same real-world date — signedDate is
  // an ordinary staff-editable field that's existed since before this
  // feature and can be set by hand at any time, so it can't safely double
  // as "the webhook actually confirmed and filed this" without a false
  // positive: a lease with a hand-entered Signed date would otherwise
  // look complete before anyone ever signed anything through Dropbox
  // Sign. The webhook still sets signedDate too, once it completes, so
  // manual record-keeping stays consistent either way.
  signatureRequestId  String?   @unique
  signatureSentAt     DateTime?
  signatureCompletedAt DateTime?
  // Dropbox Sign's test_mode — a test send exercises the whole pipeline
  // (templates, webhook, auto-filing) but isn't legally binding and
  // doesn't count against the paid plan. Tracked so the status shown on
  // the lease is never mistaken for a real signed lease.
  signatureTestMode  Boolean   @default(false)
  // What was actually sent in the optional "Additional Lease Terms"
  // addendum, if anything — kept for the record, not just the live draft.
  additionalTermsText String?

  // Free-text staff notes — the Leases page's equivalent of the
  // "Leasing notes"/"Other" columns on Alina's lease-expiry spreadsheet,
  // combined into one field rather than two (the owner's call). Editable
  // inline from that page's grid, not just from this lease's own page.
  notes String?

  // Set when this lease was created via the Renewals page's "Create
  // renewal" shortcut for the same tenant(s) continuing in the same unit
  // — as opposed to a genuinely new tenancy. Distinguishing the two
  // matters because createLease()'s Dropbox auto-filing normally archives
  // the unit's current folder into "Past tenants" and starts a fresh one,
  // which is correct for a new tenant but wrong for the same tenant
  // renewing (it'd archive their live folder mid-tenancy) — a renewal
  // instead carries the predecessor's own folder/link straight across.
  // Also used to tell whether an ending lease already has a renewal
  // arranged, instead of guessing from start/end dates alone.
  renewedFromLeaseId String? @unique
  renewedFrom        Lease?  @relation("LeaseRenewal", fields: [renewedFromLeaseId], references: [id], onDelete: SetNull)
  renewedInto        Lease?  @relation("LeaseRenewal")

  tenants         LeaseTenant[]
  securityDeposit SecurityDeposit?
  rentPayments    RentPayment[]

  @@index([unitId])
  @@map("leases")
}

enum RentRecommendationDecision {
  PENDING
  APPROVED
  DECLINED
}

// Staff-recommends / owner-approves rent changes (the "Yellow" decision
// level in the leasing training manual — staff researches comparables and
// recommends a rent, but an owner must approve it before it's communicated
// or advertised). Approving one writes currentRent on the linked Unit — see
// decideRentRecommendation() in lib/actions/rent-recommendations.ts.
model RentRecommendation {
  id           String                     @id @default(cuid())
  unitId       String
  unit         Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Snapshot of Unit.currentRent at the time this was proposed — kept
  // alongside the recommendation itself so the record reads correctly
  // later even after currentRent has since moved on.
  currentRent  Decimal                    @db.Decimal(10, 2)
  proposedRent Decimal                    @db.Decimal(10, 2)
  // The market evidence behind the number — comparables, how quickly they
  // leased, season, etc. Free text — staff writes the actual case, not a
  // rigid field set.
  reasoning    String
  decision     RentRecommendationDecision @default(PENDING)
  decisionNote String?
  proposedById String
  proposedBy   User                       @relation("ProposedRentRecommendations", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedById  String?
  decidedBy    User?                      @relation("DecidedRentRecommendations", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  createdAt    DateTime                   @default(now())

  @@index([unitId])
  @@map("rent_recommendations")
}

model LeaseTenant {
  leaseId  String
  lease    Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId String
  // Restrict, not Cascade: deleteTenant() assumes (and tells staff) that a
  // tenant with lease history can't be deleted — this makes that true
  // instead of silently dropping them off every past lease they were on.
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([leaseId, tenantId])
  @@map("lease_tenants")
}

// ---------------------------------------------------------------------------
// 5. Security deposit
// ---------------------------------------------------------------------------
model SecurityDeposit {
  id                String    @id @default(cuid())
  leaseId           String    @unique
  // Restrict, not Cascade: deleteLease() assumes (and tells staff) that a
  // lease with a deposit on file can't be deleted — this makes that true
  // instead of silently wiping the trust-accounting record for real money
  // still held for a tenant.
  lease             Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  amount            Decimal   @db.Decimal(10, 2) // capped at one month's rent per Alberta RTA; cannot increase later
  dateReceived      DateTime
  trustAccountRef   String? // points at the dedicated trust sub-account
  interestRateYear  Int? // the calendar year whose AB-regulation interest rate applies
  interestAccrued   Decimal?  @db.Decimal(10, 2)
  dateReturned      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deductions SecurityDepositDeduction[]

  @@map("security_deposits")
}

// Itemized deductions from a returned deposit.
model SecurityDepositDeduction {
  id                String          @id @default(cuid())
  securityDepositId String
  securityDeposit   SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)
  description       String
  amount            Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())

  @@map("security_deposit_deductions")
}

// One row per lease per calendar month — the rent "charge" for that
// period. Created automatically (see ensureCurrentPeriodPayments() in
// src/lib/rent-reminders.ts) for every currently-active lease; staff mark
// it paid. Rent is assumed due on the 1st of each month — this app has no
// per-lease due-day field today, so every lease is treated the same way.
model RentPayment {
  id       String    @id @default(cuid())
  leaseId  String
  // Restrict, not Cascade: this is a real payment record, same reasoning
  // as SecurityDeposit — a lease with payment history on file shouldn't
  // be deletable out from under it.
  lease    Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  period   DateTime // first of the month this charge is for, e.g. 2026-10-01
  amountDue Decimal  @db.Decimal(10, 2) // snapshot of the lease's rent at the time this period was created — a later rent change doesn't rewrite past periods
  paidDate DateTime? // null = unpaid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, period])
  @@index([leaseId])
  @@map("rent_payments")
}

// Alberta-regulation deposit interest rate by year. A lookup table (not a
// hardcoded constant) because the rate is re-set annually — 0% for 2026.
model DepositInterestRate {
  year        Int   @id
  ratePercent Decimal @db.Decimal(5, 3)

  @@map("deposit_interest_rates")
}

// Statistics Canada annual CPI, by year — the cap on affordable-unit rent
// escalation under CMHC MLI Select. A lookup table so it is entered, not
// hardcoded, each year.
model CpiRate {
  year        Int     @id
  ratePercent Decimal @db.Decimal(5, 3)

  @@map("cpi_rates")
}

// One connected Dropbox account used for automatic lease-document filing —
// only one connection is ever active at a time; reconnecting overwrites
// the stored refresh token rather than keeping old ones around.
// basePath is the root folder everything else is built under (e.g.
// "/Pen Lake Ventures/Leases"), set once from Settings; project folders
// underneath it are expected to be named to match ProjectEntity.internalName
// exactly (e.g. "Killarney23"). DROPBOX_APP_KEY/SECRET (the app's own OAuth
// credentials, not this token) live in the environment, not here.
model DropboxConnection {
  id           String   @id @default(cuid())
  accountEmail String   @unique
  refreshToken String
  basePath     String   @default("")
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dropbox_connections")
}

// No OAuth "connect" step for Dropbox Sign — it's a single business-owned
// API key (DROPBOX_SIGN_API_KEY, an environment variable, same pattern as
// Twilio/Anthropic) plus these editable template IDs, which the owner
// creates once in the Dropbox Sign dashboard and pastes in here. A
// singleton row (id is always "singleton") rather than one row per
// something, matching how there's exactly one set of these values for the
// whole app.
model SigningSettings {
  id                       String   @id @default("singleton")
  landlordSignerName       String?
  landlordSignerEmail      String?
  leaseTownhomeTemplateId  String?
  leaseSuiteTemplateId     String?
  smokingAddendumTemplateId String?
  additionalTermsTemplateId String?
  updatedAt                DateTime @updatedAt

  @@map("signing_settings")
}

// Owner-only financials. Rental income is never stored here — it's summed
// live from RentPayment (the same ledger Rent already uses), so there's
// nothing to duplicate or let go stale. Expenses are the one thing nobody
// else tracks yet, so they get one row per project per month, categorized
// to match the categories on the spreadsheet this replaces. `month` follows
// RentPayment.period's own convention: UTC midnight of the 1st, a calendar
// marker rather than a real instant.
model MonthlyExpense {
  id                    String   @id @default(cuid())
  projectEntityId       String
  projectEntity         ProjectEntity @relation(fields: [projectEntityId], references: [id], onDelete: Restrict)
  month                 DateTime
  mortgage              Decimal  @db.Decimal(10, 2) @default(0)
  propertyTax           Decimal  @db.Decimal(10, 2) @default(0)
  insurance             Decimal  @db.Decimal(10, 2) @default(0)
  propertyManagementFee Decimal  @db.Decimal(10, 2) @default(0)
  leasingFee            Decimal  @db.Decimal(10, 2) @default(0)
  maintenance           Decimal  @db.Decimal(10, 2) @default(0)
  legal                 Decimal  @db.Decimal(10, 2) @default(0)
  generalExpense        Decimal  @db.Decimal(10, 2) @default(0)
  accounting            Decimal  @db.Decimal(10, 2) @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectEntityId, month])
  @@index([month])
  @@map("monthly_expenses")
}

// The rarely-changing, owner-only portfolio figures (property value, loan
// rate, equity) — a handful of fields updated by hand occasionally, not
// part of the monthly routine the way MonthlyExpense is. Singleton, same
// pattern as SigningSettings above.
// One row per project — was a single portfolio-wide singleton until the
// owner asked for these broken out like everything else on the
// Financials page. See the 20261124_financial_settings_per_project
// migration for how any existing singleton row's values were carried
// forward instead of silently dropped.
model FinancialSettings {
  id                   String        @id @default(cuid())
  projectEntityId      String        @unique
  projectEntity        ProjectEntity @relation(fields: [projectEntityId], references: [id], onDelete: Cascade)
  totalCityAssessment  Decimal?      @db.Decimal(14, 2)
  estimatedMarketValue Decimal?      @db.Decimal(14, 2)
  // Current loan balance — Assumed equity is derived from this and
  // estimatedMarketValue (market value minus loan balance) rather than
  // stored separately, so the two can never drift out of sync with each
  // other the way a hand-entered "assumed equity" number could.
  loanBalance          Decimal?      @db.Decimal(14, 2)
  avgLoanInterestRate  Decimal?      @db.Decimal(6, 4)
  // IROR removed from the Financials page for now (no agreed formula yet)
  // — left here, untouched and unused, rather than dropped, so the owner
  // can pick this up again once the rest of the app is further along.
  iror                 Decimal?      @db.Decimal(6, 4)
  updatedAt            DateTime      @updatedAt

  @@map("financial_settings")
}

// ---------------------------------------------------------------------------
// 6. Maintenance ticket
// ---------------------------------------------------------------------------
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

model MaintenanceTicket {
  id          String         @id @default(cuid())
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  description String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(NEW)
  vendorId    String?
  // Restrict, not SetNull: deleteVendor() assumes (and tells staff) that a
  // vendor with ticket history can't be deleted — this makes that true
  // instead of silently erasing which vendor did the work on old tickets.
  vendor      Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cost        Decimal?       @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([unitId])
  @@index([status])
  @@map("maintenance_tickets")
}

// ---------------------------------------------------------------------------
// 7. Vendor
// ---------------------------------------------------------------------------
model Vendor {
  id          String   @id @default(cuid())
  name        String
  type        String // e.g. handyman, plumber
  contactPhone String?
  contactEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets        MaintenanceTicket[]

  @@map("vendors")
}

// ---------------------------------------------------------------------------
// 8. Compliance record (CMHC annual reporting)
// ---------------------------------------------------------------------------
model ComplianceRecord {
  id                          String        @id @default(cuid())
  projectEntityId             String
  projectEntity               ProjectEntity @relation(fields: [projectEntityId], references: [id], onDelete: Restrict)
  year                        Int
  affordableUnitRentsReported Json // snapshot of rents for affordable units that year
  submittedDate               DateTime?
  // Set by the project's lender, annually — varies lender to lender and
  // year to year, so there's no fixed rule to compute this from (unlike
  // the rent/deposit deadlines elsewhere). Purely a place to record it
  // once known; nothing flags an approaching or missed one yet — that
  // needs a real pattern of dates on file first.
  reportingDeadline           DateTime?
  createdAt                   DateTime      @default(now())

  @@unique([projectEntityId, year])
  @@map("compliance_records")
}
