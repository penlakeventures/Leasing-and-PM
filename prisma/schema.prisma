// Pen Lake Ventures — Leasing & PM system
// Phase 1 schema, translated from docs/phase0_data_model.md.
// Scope: leasing and property management only. Development/construction stays out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

// Two users today (Ryan, Alina), both full access. Role is a plain string
// (not an enum) so new roles — e.g. an outsourced PM company with scoped
// access — can be introduced later without a schema migration.
model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               String   @default("admin")
  // Defaults to true (not false) so that adding this column to an
  // already-populated users table is the conservative choice: any
  // existing account is treated as "not confirmed to have rotated its
  // password" until proven otherwise, rather than silently trusting it.
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  handledCommunications CommunicationLog[]
  decidedScreenings     TenantScreening[]
  assignedTours         Lead[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// 1. Project entity — the 7 single-purpose corporations, each the legal
//    owner of one property.
// ---------------------------------------------------------------------------
model ProjectEntity {
  id           String   @id @default(cuid())
  internalName String   @unique // e.g. "Killarney23" — matches financial statements
  websiteCode  String   @unique // e.g. "KLY2337" — matches penventures.ca
  neighbourhood String
  address      String
  occupancyDate DateTime
  cmhcLoanRef  String? // optional, for later linking to renewal-ladder tracking
  // Owner-specified display order (not alphabetical) — every list of
  // projects, and every unit list grouped by project, sorts by this.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  units             Unit[]
  complianceRecords ComplianceRecord[]

  @@map("project_entities")
}

// ---------------------------------------------------------------------------
// 2. Unit
// ---------------------------------------------------------------------------
enum CmhcDesignation {
  MARKET
  AFFORDABLE
}

enum TenancyType {
  EXTERNAL
  INTERNAL // e.g. the barn — a Pen-to-Pen payment, flagged for financial reporting clarity
}

model Unit {
  id              String          @id @default(cuid())
  projectEntityId String
  projectEntity   ProjectEntity   @relation(fields: [projectEntityId], references: [id], onDelete: Restrict)
  unitNumber      String // how this unit is identified on the real rent roll/address (e.g. "203") — the project address plus this uniquely identifies the unit, so a separate town/suite category isn't needed
  bedrooms        Int
  sqft            Int?
  cmhcDesignation CmhcDesignation
  baseRent        Decimal         @db.Decimal(10, 2)
  currentRent     Decimal         @db.Decimal(10, 2)
  tenancyType     TenancyType     @default(EXTERNAL)
  // Which lease template a new lease for this unit uses (see "Send for
  // signature" on the Lease page): true = utilities included in rent
  // (the "Suite" template), false = tenant pays utilities directly (the
  // "Townhome" template). Defaults off since that's the more common case
  // portfolio-wide; set per unit, not inferred from anything else.
  utilitiesIncludedInRent Boolean @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  leases    Lease[]
  leads     Lead[]
  tickets   MaintenanceTicket[]

  @@index([projectEntityId])
  @@map("units")
}

// ---------------------------------------------------------------------------
// 3. Tenant
// ---------------------------------------------------------------------------
model Tenant {
  id                  String  @id @default(cuid())
  name                String
  phone               String?
  email                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // AI-drafted maintenance ticket, generated on demand from this tenant's
  // recent texts (never automatically) — sits here for a human to review
  // and turn into a real MaintenanceTicket, or discard, same pattern as
  // Lead.draftReply. Cleared once a ticket is actually created from it.
  draftTicketDescription String?
  draftTicketPriority    TicketPriority?

  // AI-drafted reply to this tenant's most recent text, generated on demand
  // (Phase 3 tenant Q&A) — same pattern as Lead.draftReply and the ticket
  // draft above: a human reviews/edits it in the Texts panel and only an
  // explicit Send commits it. Cleared once sent.
  draftReply String?

  // Orchestrator inbox — same meaning as Lead.attentionClearedAt above.
  attentionClearedAt DateTime?

  leases          LeaseTenant[]
  tickets         MaintenanceTicket[]
  communications  CommunicationLog[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// 4. Lease (+ join table for multiple tenants per lease)
// ---------------------------------------------------------------------------
model Lease {
  id                  String    @id @default(cuid())
  unitId              String
  unit                Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate           DateTime
  endDate             DateTime?
  periodic            Boolean   @default(false) // month-to-month / periodic tenancy with no fixed end date
  rentAmount           Decimal   @db.Decimal(10, 2)
  lastRentIncreaseDate DateTime? // anchor for the 365-day-between-increases rule; null = never increased since this app tracked it
  rentIncreaseNoticeGivenDate DateTime? // when written notice was given for the current rentAmount, if it was an increase
  lastMonthRentPrepaid Decimal?  @db.Decimal(10, 2)
  pets                 String? // free text, e.g. "dog, cat"
  signedDate           DateTime?
  documentLink         String?
  // The actual Dropbox path behind documentLink (a shared link isn't
  // something the Dropbox upload API can write to directly) — set
  // alongside it when prepareLeaseFolder() creates the folder, so
  // uploading a document later (e.g. a SingleKey report once someone's
  // approved) has a stable target without re-deriving or re-creating
  // anything. Null for a lease predating this, or one where staff pasted
  // a link by hand instead — upload just isn't offered there.
  documentsFolderPath  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // E-signature (Dropbox Sign) — set once "Send for signature" is used.
  // signatureRequestId is null until sent; signedDate (above) gets
  // stamped automatically once the webhook confirms everyone's signed,
  // same field staff could already set by hand for an off-app signature.
  signatureRequestId String?   @unique
  signatureSentAt    DateTime?
  // What was actually sent in the optional "Additional Lease Terms"
  // addendum, if anything — kept for the record, not just the live draft.
  additionalTermsText String?

  tenants         LeaseTenant[]
  securityDeposit SecurityDeposit?
  rentPayments    RentPayment[]

  @@index([unitId])
  @@map("leases")
}

model LeaseTenant {
  leaseId  String
  lease    Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId String
  // Restrict, not Cascade: deleteTenant() assumes (and tells staff) that a
  // tenant with lease history can't be deleted — this makes that true
  // instead of silently dropping them off every past lease they were on.
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([leaseId, tenantId])
  @@map("lease_tenants")
}

// ---------------------------------------------------------------------------
// 5. Security deposit
// ---------------------------------------------------------------------------
model SecurityDeposit {
  id                String    @id @default(cuid())
  leaseId           String    @unique
  // Restrict, not Cascade: deleteLease() assumes (and tells staff) that a
  // lease with a deposit on file can't be deleted — this makes that true
  // instead of silently wiping the trust-accounting record for real money
  // still held for a tenant.
  lease             Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  amount            Decimal   @db.Decimal(10, 2) // capped at one month's rent per Alberta RTA; cannot increase later
  dateReceived      DateTime
  trustAccountRef   String? // points at the dedicated trust sub-account
  interestRateYear  Int? // the calendar year whose AB-regulation interest rate applies
  interestAccrued   Decimal?  @db.Decimal(10, 2)
  dateReturned      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deductions SecurityDepositDeduction[]

  @@map("security_deposits")
}

// Itemized deductions from a returned deposit.
model SecurityDepositDeduction {
  id                String          @id @default(cuid())
  securityDepositId String
  securityDeposit   SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)
  description       String
  amount            Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())

  @@map("security_deposit_deductions")
}

// One row per lease per calendar month — the rent "charge" for that
// period. Created automatically (see ensureCurrentPeriodPayments() in
// src/lib/rent-reminders.ts) for every currently-active lease; staff mark
// it paid. Rent is assumed due on the 1st of each month — this app has no
// per-lease due-day field today, so every lease is treated the same way.
model RentPayment {
  id       String    @id @default(cuid())
  leaseId  String
  // Restrict, not Cascade: this is a real payment record, same reasoning
  // as SecurityDeposit — a lease with payment history on file shouldn't
  // be deletable out from under it.
  lease    Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  period   DateTime // first of the month this charge is for, e.g. 2026-10-01
  amountDue Decimal  @db.Decimal(10, 2) // snapshot of the lease's rent at the time this period was created — a later rent change doesn't rewrite past periods
  paidDate DateTime? // null = unpaid
  // Set once a reminder text has actually gone out for this period, so
  // the daily check never double-texts the same unpaid month.
  reminderSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, period])
  @@index([leaseId])
  @@map("rent_payments")
}

// Alberta-regulation deposit interest rate by year. A lookup table (not a
// hardcoded constant) because the rate is re-set annually — 0% for 2026.
model DepositInterestRate {
  year        Int   @id
  ratePercent Decimal @db.Decimal(5, 3)

  @@map("deposit_interest_rates")
}

// Statistics Canada annual CPI, by year — the cap on affordable-unit rent
// escalation under CMHC MLI Select. A lookup table so it is entered, not
// hardcoded, each year.
model CpiRate {
  year        Int     @id
  ratePercent Decimal @db.Decimal(5, 3)

  @@map("cpi_rates")
}

// One connected Google account whose calendar tour events are created on
// — reconnecting overwrites the stored refresh token rather than keeping
// old ones around, since only one connection is ever active at a time.
// GOOGLE_CLIENT_ID/SECRET (the app's own OAuth credentials, not this
// token) live in the environment, not here.
model CalendarConnection {
  id           String   @id @default(cuid())
  googleEmail  String   @unique
  refreshToken String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("calendar_connections")
}

// One connected Dropbox account used for automatic lease-document filing —
// same one-active-connection-at-a-time shape as CalendarConnection.
// basePath is the root folder everything else is built under (e.g.
// "/Pen Lake Ventures/Leases"), set once from Settings; project folders
// underneath it are expected to be named to match ProjectEntity.internalName
// exactly (e.g. "Killarney23"). DROPBOX_APP_KEY/SECRET (the app's own OAuth
// credentials, not this token) live in the environment, not here.
model DropboxConnection {
  id           String   @id @default(cuid())
  accountEmail String   @unique
  refreshToken String
  basePath     String   @default("")
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dropbox_connections")
}

// No OAuth "connect" step for Dropbox Sign — it's a single business-owned
// API key (DROPBOX_SIGN_API_KEY, an environment variable, same pattern as
// Twilio/Anthropic) plus these editable template IDs, which the owner
// creates once in the Dropbox Sign dashboard and pastes in here. A
// singleton row (id is always "singleton") rather than one row per
// something, matching how there's exactly one set of these values for the
// whole app.
model SigningSettings {
  id                       String   @id @default("singleton")
  landlordSignerName       String?
  landlordSignerEmail      String?
  leaseTownhomeTemplateId  String?
  leaseSuiteTemplateId     String?
  smokingAddendumTemplateId String?
  additionalTermsTemplateId String?
  updatedAt                DateTime @updatedAt

  @@map("signing_settings")
}

// ---------------------------------------------------------------------------
// 6. Lead
// ---------------------------------------------------------------------------
enum LeadSource {
  RENTFASTER
  FACEBOOK_MARKETPLACE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  TOURING
  APPLIED
  SCREENED
  LEASED
  LOST
}

model Lead {
  id           String     @id @default(cuid())
  source       LeadSource
  unitId       String? // null = general interest, not tied to a specific unit
  unit         Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contactName  String?
  contactPhone String?
  contactEmail String?
  status       LeadStatus @default(NEW)
  requestedMoveInDate DateTime?
  message      String? // free-text inquiry from the lead, plus listing details for auto-captured leads that couldn't be matched to a specific unit
  // Dedupe key for auto-captured leads (e.g. RentFaster's per-lead reply
  // token) so the same inbound email can't create the lead twice if it's
  // ever delivered/retried more than once. Null for manually-entered leads.
  externalRef  String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Tour scheduling. tourEventId is Google Calendar's own event ID for
  // the booked tour — kept so a later cancel/reschedule can find and
  // remove the exact event rather than guessing, and so re-rendering
  // this lead doesn't need to re-derive whether a tour is booked from
  // anything fuzzier than "does this still point at a real event".
  tourAt        DateTime?
  tourStaffId   String?
  tourStaff     User?     @relation(fields: [tourStaffId], references: [id], onDelete: SetNull)
  tourEventId   String?

  // AI-drafted reply text, generated on demand (never automatically) from
  // this lead's info and text conversation so far — always sits here for a
  // human to review/edit before sending, never sent on its own. Cleared
  // once an actual reply goes out, successful or not tied to this draft.
  draftReply String?

  // Orchestrator inbox: set to "now" whenever this lead's latest inbound
  // text has been handled (a real reply went out, or staff dismissed it
  // manually) — a lead shows up in the Inbox whenever its most recent
  // text is INBOUND and newer than this. Null means never cleared, so a
  // lead with any inbound text and no reply yet always shows up.
  attentionClearedAt DateTime?

  communications CommunicationLog[]
  screening      TenantScreening?

  @@index([unitId])
  @@map("leads")
}

// SingleKey (or similar) is a web portal, not something this app has API
// access to — staff request the report on SingleKey's own site, then
// record the outcome here. This is deliberately a *record*, not a
// decision-maker: the actual accept/decline call is always a person's,
// tracked in decidedBy/decidedAt, never derived automatically from the
// report itself.
enum ScreeningDecision {
  PENDING
  APPROVED
  DECLINED
}

model TenantScreening {
  id            String            @id @default(cuid())
  leadId        String            @unique
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  requestedDate DateTime?
  completedDate DateTime?
  reportUrl     String? // link to the report on SingleKey's site, or wherever it's filed
  summary       String? // free text — SingleKey's own score/recommendation, copied over by staff rather than a rigid field set this app can't verify matches their report format
  decision      ScreeningDecision @default(PENDING)
  decisionNotes String?
  decidedById   String?
  decidedBy     User?             @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("tenant_screenings")
}

// ---------------------------------------------------------------------------
// 7. Maintenance ticket
// ---------------------------------------------------------------------------
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

model MaintenanceTicket {
  id          String         @id @default(cuid())
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  description String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(NEW)
  vendorId    String?
  // Restrict, not SetNull: deleteVendor() assumes (and tells staff) that a
  // vendor with ticket history can't be deleted — this makes that true
  // instead of silently erasing which vendor did the work on old tickets.
  vendor      Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cost        Decimal?       @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  // Set when the "Notify vendor" text actually goes out — lets the ticket
  // show whether/when the vendor was told, distinct from just having one
  // assigned (assigning and notifying are two separate, deliberate steps).
  vendorNotifiedAt DateTime?

  @@index([unitId])
  @@index([status])
  @@map("maintenance_tickets")
}

// ---------------------------------------------------------------------------
// 8. Vendor
// ---------------------------------------------------------------------------
model Vendor {
  id          String   @id @default(cuid())
  name        String
  type        String // e.g. handyman, plumber
  contactPhone String?
  contactEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Orchestrator inbox — same meaning as Lead.attentionClearedAt. Vendors
  // never get an AI-drafted reply (see triageInboundMessage) — just
  // flagged for a human to read and dismiss or reply to by hand.
  attentionClearedAt DateTime?

  tickets        MaintenanceTicket[]
  communications CommunicationLog[]

  @@map("vendors")
}

// ---------------------------------------------------------------------------
// 9. Communication log
// ---------------------------------------------------------------------------
enum CommChannel {
  TEXT
  EMAIL
  CALL
  MESSENGER
}

enum CommDirection {
  INBOUND
  OUTBOUND
}

model CommunicationLog {
  id          String        @id @default(cuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vendorId    String?
  vendor      Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  channel     CommChannel
  direction   CommDirection
  timestamp   DateTime      @default(now())
  summary     String
  handledById String? // null = handled by an automated agent/integration
  handledBy   User?         @relation(fields: [handledById], references: [id], onDelete: SetNull)
  // Dedupe key for auto-captured entries (e.g. a Messenger message ID) so
  // a webhook retry logs the same message once, not twice. Null for
  // manually-entered communications.
  externalRef String?       @unique

  @@index([tenantId])
  @@index([leadId])
  @@index([vendorId])
  @@map("communication_logs")
}

// ---------------------------------------------------------------------------
// 10. Compliance record (CMHC annual reporting)
// ---------------------------------------------------------------------------
model ComplianceRecord {
  id                          String        @id @default(cuid())
  projectEntityId             String
  projectEntity               ProjectEntity @relation(fields: [projectEntityId], references: [id], onDelete: Restrict)
  year                        Int
  affordableUnitRentsReported Json // snapshot of rents for affordable units that year
  submittedDate               DateTime?
  createdAt                   DateTime      @default(now())

  @@unique([projectEntityId, year])
  @@map("compliance_records")
}
