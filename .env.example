DATABASE_URL="postgresql://user:password@localhost:5432/leasing_pm"

# NextAuth — generate a real secret with: npx auth secret
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# One-time bootstrap: visiting /api/seed?token=<this value> loads the real
# portfolio + user accounts. Set to any random string; see README for the
# no-terminal-needed setup flow. Safe to remove from the environment (or
# just forget) once you've run it — the app doesn't need it afterward.
SEED_TOKEN="replace-me-too"

# Shared secret the RentFaster inbound-email webhook checks for, in the
# URL as ?token=<this value> — set to any random string, then use that
# same URL (https://<your-app>/api/leads/rentfaster-inbound?token=...) as
# the destination when setting up email forwarding. Needed only once
# that's wired up.
RENTFASTER_INBOUND_TOKEN="replace-me-as-well"

# Facebook Messenger webhook (Meta App Dashboard → your app → Webhooks):
# FACEBOOK_WEBHOOK_VERIFY_TOKEN — any random string you choose; enter the
#   same value in Meta's webhook setup screen ("Verify Token" field).
# FACEBOOK_APP_SECRET — from Meta App Dashboard → App Settings → Basic
#   ("App Secret"). Used to confirm webhook requests actually came from
#   Meta, not just anyone hitting this public URL.
# FACEBOOK_PAGE_ACCESS_TOKEN — generated once the app's Messenger product
#   is connected to your Page (Meta App Dashboard → Messenger → Settings
#   → Access Tokens). Optional — without it, leads are still captured,
#   just without the sender's name attached.
FACEBOOK_WEBHOOK_VERIFY_TOKEN="replace-me-once-more"
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
