DATABASE_URL="postgresql://user:password@localhost:5432/leasing_pm"

# NextAuth — generate a real secret with: npx auth secret
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# One-time bootstrap: visiting /api/seed?token=<this value> loads the real
# portfolio + user accounts. Set to any random string; see README for the
# no-terminal-needed setup flow. Safe to remove from the environment (or
# just forget) once you've run it — the app doesn't need it afterward.
SEED_TOKEN="replace-me-too"

# Shared secret the RentFaster inbound-email webhook checks for, in the
# URL as ?token=<this value> — set to any random string, then use that
# same URL (https://<your-app>/api/leads/rentfaster-inbound?token=...) as
# the destination when setting up email forwarding. Needed only once
# that's wired up.
RENTFASTER_INBOUND_TOKEN="replace-me-as-well"

# Facebook Messenger webhook (Meta App Dashboard → your app → Webhooks):
# FACEBOOK_WEBHOOK_VERIFY_TOKEN — any random string you choose; enter the
#   same value in Meta's webhook setup screen ("Verify Token" field).
# FACEBOOK_APP_SECRET — from Meta App Dashboard → App Settings → Basic
#   ("App Secret"). Used to confirm webhook requests actually came from
#   Meta, not just anyone hitting this public URL.
# FACEBOOK_PAGE_ACCESS_TOKEN — generated once the app's Messenger product
#   is connected to your Page (Meta App Dashboard → Messenger → Settings
#   → Access Tokens). Optional — without it, leads are still captured,
#   just without the sender's name attached.
FACEBOOK_WEBHOOK_VERIFY_TOKEN="replace-me-once-more"
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Google Calendar (tour scheduling) — from Google Cloud Console → APIs &
# Services → Credentials, an OAuth 2.0 Client ID of type "Web application"
# with an authorized redirect URI of
# https://<your-app>/api/calendar/callback. Only these two app-level
# values live here; the actual connected account's refresh token is
# stored in the database once you connect via Settings → Calendar, not
# in an environment variable, so reconnecting never needs a redeploy.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dropbox (automatic lease-document filing) — from the Dropbox App Console
# (dropbox.com/developers/apps), a "Scoped access" app with "Full Dropbox"
# access, and a redirect URI of https://<your-app>/api/dropbox/callback.
# Same pattern as Google Calendar above: only the app-level key/secret live
# here, the connected account's refresh token and base folder path are
# stored in the database once you connect via Settings → Documents.
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""

# Twilio (SMS) — from the Twilio Console (console.twilio.com), a phone
# number purchased there, and its Account SID/Auth Token from the console
# dashboard. Unlike Google/Dropbox above, there's no OAuth "connect" step —
# instead, set the phone number's "A message comes in" webhook (Console →
# Phone Numbers → your number → Messaging) to
# https://<your-app>/api/sms/twilio-webhook. See Settings → Texting once
# deployed for that exact URL.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Anthropic (AI-drafted lead replies) — an API key from
# console.anthropic.com. Only used to draft a suggested text reply for a
# staff member to review on a lead's page — never sends anything itself.
ANTHROPIC_API_KEY=""

# Shared secret the rent-reminders cron endpoint checks for, in the URL as
# ?token=<this value> — set to any random string. A GitHub Actions
# scheduled workflow (.github/workflows/rent-reminders.yml) calls
# https://<your-app>/api/cron/rent-reminders?token=... once a day; that
# workflow needs this same value saved as a GitHub repo secret named
# CRON_TOKEN (Settings → Secrets and variables → Actions), plus
# APP_BASE_URL set to your deployed app's URL.
CRON_TOKEN="replace-me-too-please"
