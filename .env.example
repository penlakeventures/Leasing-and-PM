DATABASE_URL="postgresql://user:password@localhost:5432/leasing_pm"

# NextAuth — generate a real secret with: npx auth secret
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# One-time bootstrap: visiting /api/seed?token=<this value> loads the real
# portfolio + user accounts. Set to any random string; see README for the
# no-terminal-needed setup flow. Safe to remove from the environment (or
# just forget) once you've run it — the app doesn't need it afterward.
SEED_TOKEN="replace-me-too"

# Shared secret the RentFaster inbound-email webhook checks for, in the
# URL as ?token=<this value> — set to any random string, then use that
# same URL (https://<your-app>/api/leads/rentfaster-inbound?token=...) as
# the destination when setting up email forwarding. Needed only once
# that's wired up.
RENTFASTER_INBOUND_TOKEN="replace-me-as-well"
